# Your Gmail Address
EMAIL_USER=your_email@gmail.com

# Your Gmail App Password (NOT your regular password)
# To get this, go to Google Account -> Security -> 2-Step Verification -> App Passwords
EMAIL_PASS=your_app_password

# The email address where you want to receive the messages (usually the same as EMAIL_USER)
RECEIVER_EMAIL=your_email@gmail.com

# Port for the server to run on
PORT=3000
